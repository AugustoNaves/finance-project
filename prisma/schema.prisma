generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid())
  name                String
  email               String                @unique
  passwordHash        String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  transactions        Transaction[]
  categories          Category[]
  budgets             Budget[]
  goals               Goal[]
  passwordResetTokens PasswordResetToken[]
  importBatches       ImportBatch[]
  categoryRules       CategoryRule[]

  @@map("users")
}

model Transaction {
  id            String   @id @default(uuid())
  description   String
  amount        Float
  category      String
  date          DateTime @default(now())
  type          String?
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  importItem    ImportBatchItem?

  @@index([userId])
  @@map("transactions")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Budget {
  id        String   @id @default(uuid())
  category  String
  amount    Float
  month     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
  @@index([userId])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(uuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  color         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model ImportBatch {
  id             String            @id @default(uuid())
  fileName       String
  fileHash       String
  issuer         String?
  referenceMonth String
  dueDate        DateTime?
  statedTotal    Float?
  importedTotal  Float
  itemCount      Int
  createdAt      DateTime          @default(now())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          ImportBatchItem[]

  @@index([userId])
  @@index([userId, fileHash])
  @@map("import_batches")
}

model ImportBatchItem {
  id            String      @id @default(uuid())
  batchId       String
  batch         ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("import_batch_items")
}

model CategoryRule {
  id        String   @id @default(uuid())
  pattern   String
  category  String
  type      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
  @@map("category_rules")
}
