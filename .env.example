# Copie para .env e preencha. O `npm install` roda `prisma generate`,
# que falha se DIRECT_URL não estiver definida.

# PostgreSQL via pooler (porta 6543 no Supabase) — usado pela aplicação (src/lib/prisma.ts)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"

# PostgreSQL conexão direta (porta 5432) — usado pelo Prisma CLI/migrations (prisma.config.ts)
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Segredo do cookie de sessão (HMAC-SHA256). Mínimo 32 caracteres: `openssl rand -hex 32`
SESSION_SECRET=""

# URL pública do app, usada no link do e-mail de redefinição de senha
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google reCAPTCHA v3 (login)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Resend (e-mail de redefinição de senha)
RESEND_API_KEY=""
EMAIL_FROM="Finanças Pessoais <no-reply@seudominio.com>"
